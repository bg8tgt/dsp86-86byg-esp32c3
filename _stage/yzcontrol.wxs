<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package
      Name="YzControl 云台控制 1.7.1"
      Manufacturer="YiZhou"
      Version="1.7.1"
      UpgradeCode="6B6E9C0E-9F1C-4A9B-8D52-11AA22BB33CC"
      Scope="perMachine"
      Codepage="936"
      Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的 YzControl，请先在「应用和功能」中卸载后再安装本版本。" />
    <MediaTemplate EmbedCab="yes" />

    <!-- 安装向导：欢迎 → 许可 → 安装目录 → 确认 → 进度 → 完成（可勾选立即启动） -->
    <WixVariable Id="WixUILicenseRtf" Value="license.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="立即启动 YzControl" />
    <Property Id="WixShellExecTarget" Value="[#YzExe]" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />

    <!-- 控制面板中的产品信息 -->
    <Icon Id="AppIcon" SourceFile="$(Staging)\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPCONTACT" Value="YiZhou" />

    <!-- 安装目录路径写入注册表，卸载时回读，用于递归清空安装目录（含运行期生成的文件） -->
    <Property Id="YZ_INSTALLDIR_REMEMBER">
      <RegistrySearch Id="RsInstallDir" Root="HKLM" Key="Software\YiZhou\YzControl" Name="InstallDir" Type="raw" />
    </Property>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="YzControl">
        <Component Id="ExeMain" Guid="1E1F5A0B-6D21-4F0E-9C77-1D3C8B2A9001">
          <File Id="YzExe" Source="$(Staging)\YzControl.exe" />
          <File Id="YzCfg" Source="$(Staging)\YzControl.exe.config" />
          <RegistryValue Root="HKLM" Key="Software\YiZhou\YzControl" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" />
          <util:RemoveFolderEx On="uninstall" Property="YZ_INSTALLDIR_REMEMBER" />
        </Component>
        <Directory Id="SatDataDir" Name="SatData">
          <Component Id="SatDataFiles" Guid="1E1F5A0B-6D21-4F0E-9C77-1D3C8B2A9002">
            <File Id="OmmCache" Source="$(Staging)\SatData\celestrak_omm_cache.json" />
            <File Id="TpCache" Source="$(Staging)\SatData\transponders_cache.json" />
            <RemoveFolder Id="RmSatDataDir" On="uninstall" />
          </Component>
        </Directory>
        <Directory Id="SatDir" Name="Sat">
          <Component Id="SatRefFiles" Guid="1E1F5A0B-6D21-4F0E-9C77-1D3C8B2A9003">
            <File Id="Sgp4Ref" Source="$(Staging)\Sat\sgp4_ref.json" />
            <File Id="WorldLand" Source="$(Staging)\Sat\world_land.txt" />
            <RemoveFolder Id="RmSatDir" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- 桌面快捷方式（perMachine 下 DesktopFolder 即「所有用户桌面」） -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="ShortcutDesktop" Guid="1E1F5A0B-6D21-4F0E-9C77-1D3C8B2A9005">
        <Shortcut Id="DesktopYz"
                  Name="YzControl"
                  Description="YzControl · 云台控制与卫星追踪"
                  Target="[#YzExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\YiZhou\YzControl" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- 开始菜单快捷方式 -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuDir" Name="YzControl">
        <Component Id="ShortcutMenu" Guid="1E1F5A0B-6D21-4F0E-9C77-1D3C8B2A9006">
          <Shortcut Id="StartMenuYz"
                    Name="YzControl"
                    Description="YzControl · 云台控制与卫星追踪"
                    Target="[#YzExe]"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" />
          <RemoveFolder Id="RemoveAppMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\YiZhou\YzControl" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="YzControl 主程序" Level="1">
      <ComponentRef Id="ExeMain" />
      <ComponentRef Id="SatDataFiles" />
      <ComponentRef Id="SatRefFiles" />
      <ComponentRef Id="ShortcutDesktop" />
      <ComponentRef Id="ShortcutMenu" />
    </Feature>
  </Package>
</Wix>
